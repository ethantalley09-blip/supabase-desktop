# Required -- get a real key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-opus-4-8
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Round 14 (performance): self-verification (verification.py) is a
# structured supported/partially_supported/unsupported classification
# task, not the final answer -- runs a cheap/fast model like every other
# background check, instead of ANTHROPIC_MODEL, since it's on the direct
# critical path of every single turn (blocks the final answer render).
VERIFICATION_MODEL=claude-haiku-4-5-20251001

# Advanced RAG: Contextual Retrieval -- ingest.py asks a cheap/fast model to
# situate each chunk within its document before embedding/BM25-indexing it
# (big accuracy win for isolated chunks). Runs automatically whenever
# ANTHROPIC_API_KEY is set; set to false to skip it even with a key.
CONTEXTUALIZE_CHUNKS=true
CONTEXT_MODEL=claude-haiku-4-5-20251001

# Advanced RAG: multi-query expansion -- before every local search, ask a
# cheap/fast model for 2 alternate phrasings and search all of them (still
# reranked against the real question only). Off by default since it's an
# extra Claude call per search; set to true to enable.
ADVANCED_QUERY_EXPANSION=false
EXPANSION_MODEL=claude-haiku-4-5-20251001

# Advanced RAG: relevance floor -- a reranked chunk scoring below this is
# dropped from results entirely instead of being padded in just to fill
# top_k. Cross-encoder logits, roughly centered on 0; more negative = laxer.
MIN_RERANK_SCORE=-6.0

# Advanced RAG: MMR diversity selection -- after reranking, the top_k
# results are chosen to avoid several near-duplicate chunks crowding out
# coverage, not just picked by highest score. 1.0 = pure relevance
# (equivalent to disabling this), 0.0 = pure diversity. No extra API calls
# either way (runs on the local embedding model).
USE_MMR=true
MMR_LAMBDA=0.7

# Advanced RAG: sentence-window retrieval -- the model reads each matched
# chunk plus this many neighboring chunks on each side (same source,
# adjacent position in the original document), so information split across
# a chunk boundary isn't lost. 0 disables it (model sees only the matched
# chunk, like before this feature existed). No extra API calls.
NEIGHBOR_WINDOW=1

# Advanced RAG: embedding-based groundedness check -- after an answer is
# generated, splits it into sentences and flags any whose best cosine
# similarity against the cited sources falls below this threshold. Local,
# free, no extra API call (reuses the already-loaded embedding model) --
# a heuristic second signal alongside verification.py's LLM-based check,
# not a replacement for it.
GROUNDEDNESS_CHECK=true
GROUNDEDNESS_THRESHOLD=0.3

# AI feature: semantic response caching -- reuse a prior answer verbatim
# for an essentially-identical question instead of rerunning the whole
# pipeline. Local embedding lookup on every question (cheap); only an
# actual hit skips Claude calls. Threshold is calibrated from measured
# data (see semantic_cache.py), not guessed: it catches someone re-asking
# essentially the same question (a typo, different capitalization/
# punctuation, minor rewording) -- NOT a loose paraphrase using different
# vocabulary, which this app's embedding model can't safely distinguish
# from an unrelated question at the question-vs-question granularity this
# cache needs. Reusing a whole wrong ANSWER is worse than a cache miss.
SEMANTIC_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.90

# AI feature: query intent routing -- one cheap/fast classification call
# per message routes chitchat/meta ("hi", "what can you do?") to a short
# direct reply with zero retrieval, instead of running the full pipeline
# on a message that was never going to need query_documents.
QUERY_INTENT_ROUTING=true
INTENT_MODEL=claude-haiku-4-5-20251001

# AI feature: document summaries -- ingest.py asks a cheap/fast model for
# one sentence per document (not per chunk -- cheaper than Contextual
# Retrieval above), shown in the sidebar next to each filename. Same
# graceful no-key-skip pattern as Contextual Retrieval.
DOC_SUMMARIES=true
DOC_SUMMARY_MODEL=claude-haiku-4-5-20251001

# AI feature: follow-up question suggestions -- after a grounded answer,
# one cheap/fast call suggests 2-3 next questions grounded in the same
# retrieved sources, shown as clickable chips.
FOLLOWUP_SUGGESTIONS=true
FOLLOWUP_MODEL=claude-haiku-4-5-20251001

# AI feature: conversation memory summarization -- once a conversation's
# history exceeds the agent's replay window, summarize the turns about to
# fall out of context (one cheap/fast call) and fold it into the system
# prompt, so a long conversation doesn't abruptly lose earlier context.
MEMORY_SUMMARIZATION=true
MEMORY_SUMMARY_MODEL=claude-haiku-4-5-20251001

# Advanced RAG: conversational query rewriting -- a query that looks
# context-dependent (short, or containing a reference word like "it"/
# "that"/"the other one") gets rewritten into a self-contained search
# query using recent conversation history (one cheap/fast call) BEFORE
# it's searched at all. A cheap local regex check gates this so a clearly
# self-contained query never pays for the extra call. Distinct from
# ADVANCED_QUERY_EXPANSION above, which paraphrases an already-clear query
# several ways -- this fixes an unclear one first.
QUERY_REWRITING=true
REWRITE_MODEL=claude-haiku-4-5-20251001

# Advanced RAG: query-adaptive hybrid fusion weighting -- a query
# containing a quoted phrase, a dollar amount, a percentage, or a bare
# multi-digit number signals it wants an exact fact (what keyword search
# is good at), so keyword search's contribution to RRF fusion is boosted
# for that query. A conceptual query fuses at equal weight, identical to
# the behavior before this feature existed. No extra API calls (pure
# regex, runs locally).
ADAPTIVE_FUSION_WEIGHTING=true
EXACT_SIGNAL_KEYWORD_BOOST=1.6

# Round 9 -- Campaign fundraising demo (see campaign_data.py, HANDOFF.md's
# Round 9 section for the full list of what these features are/aren't).
# Multilingual: translates a non-English query to English before retrieval
# (the indexed documents are English); response generation is left to the
# main agent, which is instructed to answer in the user's own language.
MULTILINGUAL=true
TRANSLATE_MODEL=claude-haiku-4-5-20251001
# Donor stewardship, competitive intelligence, and channel-variant drafts
# (stewardship.py, competitive_intel.py, channel_variants.py) reuse
# ANTHROPIC_MODEL above -- final donor/press-facing copy, not an internal
# check, so they use the same quality-tier model as the main agent rather
# than a cheap/fast one.

# Round 12 -- 10 more AI features (see HANDOFF.md's Round 12 section).
# Escalation/human-handoff detection: runs on every turn, before intent
# routing, so a frustrated or human-requesting message can't be silently
# swallowed by chitchat classification. Set to false to disable entirely.
ESCALATION_DETECTION=true
ESCALATION_SUMMARY_MODEL=claude-haiku-4-5-20251001
# 0-100; should_escalate() fires once a message's scored signals cross this.
ESCALATION_THRESHOLD=50
# "Explain it differently" rewrite presets (simpler/detailed/formal/casual)
# under any grounded answer -- cheap/fast model, since it's a rewrite of
# text the main agent already produced, not new research.
REFINE_MODEL=claude-haiku-4-5-20251001
# Drafts placeholder FAQ content from storage.unanswerable_questions() for
# staff review on the Dashboard.
FAQ_SUGGESTION_MODEL=claude-haiku-4-5-20251001
# Document staleness flagging on the Dashboard: a document whose most
# recently mentioned year is older than this many years gets flagged.
STALE_AFTER_YEARS=1
STALENESS_MODEL=claude-haiku-4-5-20251001
# Dashboard "Staff digest" executive summary generation.
DIGEST_MODEL=claude-haiku-4-5-20251001

# Optional: a second knowledge base hosted on Vectorize.io (vectorize.io).
# Leave any of these blank to skip it entirely -- the agent will just have
# its local query_documents + calculator tools, same as without this
# section. Get these from your Vectorize dashboard (organization id,
# pipeline id, and an API access token created under pipeline settings).
VECTORIZE_ORG_ID=
VECTORIZE_API_KEY=
VECTORIZE_PIPELINE_ID=
